{
  "name": "needle-test-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Plain-English test cases run on Cactus Needle 3 and dictated with Cactus Whistle, in the browser.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python3 -m http.server 8765",
    "test": "node --test 'tests/**/*.test.mjs'",
    "suite": "node scripts/suite.mjs --min-confidence 0.5",
    "speech-check": "node scripts/speech-check.mjs --bias",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
